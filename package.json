{
  "name": "task-kanban",
  "displayName": "Task Kanban",
  "description": "Kanban board for <Name>Add task folders: columns are Tasks/<stage>/ folders; dragging a card moves the task and commits its files.",
  "version": "0.2.1",
  "publisher": "local",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:Tasks/_template"
  ],
  "contributes": {
    "commands": [
      {
        "command": "taskKanban.open",
        "title": "Відкрити дошку",
        "category": "Task Kanban",
        "icon": "$(project)"
      },
      {
        "command": "taskKanban.newTask",
        "title": "Нова задача",
        "category": "Task Kanban"
      },
      {
        "command": "taskKanban.refresh",
        "title": "Оновити дошку",
        "category": "Task Kanban"
      },
      {
        "command": "taskKanban.addColumn",
        "title": "Додати колонку",
        "category": "Task Kanban"
      },
      {
        "command": "taskKanban.resetColumns",
        "title": "Повернути стандартні колонки",
        "category": "Task Kanban"
      }
    ],
    "configuration": {
      "title": "Task Kanban",
      "properties": {
        "taskKanban.tasksDir": {
          "scope": "resource",
          "type": "string",
          "default": "Tasks",
          "description": "Каталог задач відносно кореня робочої області."
        },
        "taskKanban.templateDir": {
          "scope": "resource",
          "type": "string",
          "default": "_template",
          "description": "Шаблон каталогу нової задачі (усередині tasksDir)."
        },
        "taskKanban.stages": {
          "scope": "resource",
          "type": "array",
          "description": "Етапи (колонки) у порядку відображення. dir — підкаталог tasksDir, status — значення рядка «Статус» у task.md. Керується з дошки (+ Колонка, ◀ ▶ ✎ ✕); команда «Повернути стандартні колонки» прибирає перевизначення.",
          "items": {
            "type": "object",
            "required": [
              "dir"
            ],
            "properties": {
              "dir": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "collapsed": {
                "type": "boolean",
                "description": "Колонка згорнута за замовчуванням."
              }
            }
          },
          "default": [
            { "dir": "1_new", "title": "Нове", "status": "нове" },
            { "dir": "2_queue", "title": "В черзі", "status": "в черзі" },
            { "dir": "3_work", "title": "В роботі", "status": "в роботі" },
            { "dir": "4_testing", "title": "На тестуванні", "status": "на тестуванні" },
            { "dir": "5_done", "title": "Готово", "status": "готово", "collapsed": true }
          ]
        },
        "taskKanban.commitMessage": {
          "scope": "resource",
          "type": "string",
          "default": "{number}",
          "description": "Повідомлення коміту. Підстановки: {number}, {stage}, {status}, {title}."
        },
        "taskKanban.transitions": {
          "scope": "resource",
          "type": "array",
          "default": [],
          "markdownDescription": "Дії при перенесенні задачі. `from`/`to` — `dir` етапу або `*`. Дії: `check` (перед перенесенням: попередити, якщо в каталозі задачі немає файлів за масками `files`), `commit` (після перенесення: закомітити файли задачі в репозиторій `repo`; `paths` — git-маски відносно репозиторію, `sourceDir` — підкаталог задачі, файли з якого шукаються в репозиторії за іменем). Підстановки: `{number}`, `{stage}`, `${workspaceFolder}`.",
          "items": {
            "type": "object",
            "required": [
              "to",
              "actions"
            ],
            "properties": {
              "from": {
                "type": "string",
                "default": "*"
              },
              "to": {
                "type": "string"
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "check",
                        "commit"
                      ]
                    },
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "repo": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "paths": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "sourceDir": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
